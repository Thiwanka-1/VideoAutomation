{
  "name": "vertical-skit-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Generate, render, and publish original vertical video skits.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node init && node src/server.js",
    "dev": "node init && node --watch src/server.js",
    "generate": "node src/cli.js run",
    "cli": "node src/cli.js",
    "publish": "node src/cli.js publish",
    "schedule": "node src/cli.js schedule",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.28",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "googleapis": "^176.0.0",
    "node-cron": "^4.6.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "google-tts-api": {
      "axios": "1.20.0"
    }
  }
}
