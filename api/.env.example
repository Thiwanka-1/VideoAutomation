# -------------------- Content generation --------------------
# Ollama is local, so it needs no API key. Run: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
CHANNEL_BRAND=Runtime Roommates
CHANNEL_NICHE=original workplace and software-engineering comedy skits
CONTENT_LANGUAGE=English
TARGET_DURATION_SECONDS=60

# Create a Hugging Face token with Inference Providers permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=token
HF_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=hf-inference
HF_IMAGE_WIDTH=768
HF_IMAGE_HEIGHT=1344

# google-tts-api uses an unofficial Google Translate speech endpoint. It is free,
# but has no service-level guarantee. Keep dialogue lines below 180 characters.
TTS_LANGUAGE=en
TTS_SLOW=false
TTS_LINE_GAP_SECONDS=0.25

# -------------------- Local pipeline --------------------
OUTPUT_DIR=./output
API_HOST=127.0.0.1
API_PORT=4000
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Two locks prevent accidental public publishing. Keep both true while testing.
DRY_RUN=true
REQUIRE_APPROVAL=true
PUBLISH_PLATFORMS=youtube,tiktok,facebook
SCHEDULE_CRON=0 18 * * *
SCHEDULE_TIMEZONE=Asia/Colombo
SCHEDULE_TOPICS=stand-up meeting chaos|a bug that only appears in production|the intern who reads the documentation
PUBLISH_ON_SCHEDULE=false

# -------------------- YouTube Data API v3 --------------------
# Insert OAuth credentials from Google Cloud Console. The refresh token must have
# https://www.googleapis.com/auth/youtube.upload permission.
YOUTUBE_CLIENT_ID=id
YOUTUBE_CLIENT_SECRET=id
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=replace_me
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=23
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# -------------------- TikTok Content Posting API --------------------
# Insert a user OAuth access token authorized for video.publish. An unaudited app
# can only publish privately. The code queries creator_info before every upload.
TIKTOK_ACCESS_TOKEN=replace_me
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_STITCH=false
TIKTOK_AI_GENERATED=true

# -------------------- Facebook Graph API / Reels --------------------
# Insert the numeric Page ID and a PAGE Access Token with pages_manage_posts,
# pages_read_engagement, and pages_show_list. Never use an app secret here.
FACEBOOK_PAGE_ID=replace_me
FACEBOOK_PAGE_ACCESS_TOKEN=replace_me
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_VIDEO_STATE=DRAFT
